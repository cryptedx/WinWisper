<Window
    x:Class="WinWispr.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinWispr">
    <Grid x:Name="Root">
        <Grid x:Name="ShadowHost"
              Margin="12"
              IsHitTestVisible="False" />
        <Border x:Name="Surface"
                Width="224"
                Height="48"
                Margin="12"
                Background="#CC2C2C2C"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="24"
                Padding="3"
                UseLayoutRounding="True"
                PointerEntered="Surface_PointerEntered"
                PointerExited="Surface_PointerExited">
            <Border.Resources>
                <Style x:Key="OverlayButtonStyle" TargetType="Button">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style x:Key="OverlayTextStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#F5F5F5" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Border.Resources>
            <Grid>
                <Grid x:Name="RecordingPanel">
                    <StackPanel x:Name="RecordingBars"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4" />
                </Grid>

                <Grid x:Name="HoverPanel"
                      ColumnDefinitions="*,40"
                      ColumnSpacing="6"
                      Visibility="Collapsed">
                    <Button x:Name="TranscribeButton"
                            Height="40"
                            AutomationProperties.Name="Transcribe recording"
                            Style="{StaticResource OverlayButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="#4A4A4A"
                            CornerRadius="20"
                            Click="TranscribeButton_Click">
                        <TextBlock HorizontalAlignment="Stretch"
                                   Style="{StaticResource OverlayTextStyle}"
                                   TextAlignment="Center"
                                   Text="Transcribe" />
                    </Button>

                    <Button x:Name="StopButton"
                            Grid.Column="1"
                            Width="40"
                            Height="40"
                            AutomationProperties.Name="Stop recording"
                            Style="{StaticResource OverlayButtonStyle}"
                            Background="#FF4D58"
                            CornerRadius="20"
                            Click="StopButton_Click">
                        <FontIcon FontSize="14"
                                  Foreground="White"
                                  Glyph="&#xE71A;" />
                    </Button>
                </Grid>

                <Grid x:Name="CancelPanel"
                      Margin="4,0"
                      ColumnDefinitions="20,*,40"
                      ColumnSpacing="6"
                      Visibility="Collapsed">
                    <FontIcon Width="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              FontSize="18"
                              Foreground="#A9A9A9"
                              Glyph="&#xE777;" />

                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               Style="{StaticResource OverlayTextStyle}"
                               Text="Delete recording?" />

                    <Button x:Name="CancelButton"
                            Grid.Column="2"
                            Width="40"
                            Height="40"
                            AutomationProperties.Name="Delete recording"
                            Style="{StaticResource OverlayButtonStyle}"
                            Background="#FF4D58"
                            CornerRadius="20"
                            Click="CancelButton_Click">
                        <Grid Width="40"
                              Height="40">
                            <Path x:Name="CancelProgressArc"
                                  Width="40"
                                  Height="40"
                                  IsHitTestVisible="False"
                                  Stroke="White"
                                  StrokeDashCap="Round"
                                  StrokeThickness="3" />
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="Y" />
                        </Grid>
                    </Button>
                </Grid>

                <StackPanel x:Name="StatusPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="Collapsed">
                    <ProgressRing x:Name="StatusSpinner"
                                  Width="18"
                                  Height="18"
                                  IsActive="False"
                                  IsHitTestVisible="False"
                                  Foreground="#6D5DFC" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   Style="{StaticResource OverlayTextStyle}"
                                   TextAlignment="Center"
                                   Text="Processing" />
                        <TextBlock x:Name="StatusDetail"
                                   FontSize="11"
                                   Foreground="#F5F5F5"
                                   TextAlignment="Center"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
